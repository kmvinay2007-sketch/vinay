<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        .text-wrapper {
            max-width: 600px; /* Set the maximum width */
            margin: 0 auto;   /* Center the paragraph */
            padding: 20px;    /* Add padding */
        }
    </style>
</head>
<body>
    <p class="text-wrapper">This is a paragraph that will not span the entire width of the page. It has a maximum width and some padding.</p>
</body>
</html>
